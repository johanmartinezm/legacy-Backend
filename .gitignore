# --- Secretos: NUNCA versionar ---------------------------------------------
# Estos archivos contienen credenciales reales (SSH del servidor, pasarela de
# pago, secreto de firma JWT, llave de cifrado, cuenta de servicio de Google).
# Se conservan en disco pero fuera de git. Ver *.example.* para las plantillas.
.env
config.yaml
config.docker.yaml
*-service-account.json

# Los respaldos que deja el propio procedimiento de despliegue —el DESPLIEGUE.md
# manda hacer `cp config.docker.yaml config.docker.yaml.bak.$(date ...)` antes de
# tocarlo— llevan los mismos secretos que el original. El patron los cubre a
# todos: las tres lineas de arriba son nombres exactos y no casaban con el .bak.
config*.bak*
.env.bak*

# --- Binarios compilados ----------------------------------------------------
# ~340 MB de ejecutables duplicados. Se regeneran con ./build.sh o ./build-linux.sh
# Van anclados con "/" a la raiz: sin la barra, "server" tambien casaba con la
# carpeta cmd/server/ y dejaba main.go —el unico punto de cableado de rutas—
# fuera del repositorio.
/legacy_backend
/legacy_backend_bin
/main
/server
/server_linux
/recifrar_linux
/reindexar_linux
/tmp_build
*.exe
*.exe~

# --- Archivos que suben los usuarios ----------------------------------------
# Donde ImageHandler.UploadImage deja las imagenes: fotos de perfil, imagenes de
# foros y sinergias. Son datos de personas y este repositorio es publico, asi que
# no pueden acabar versionadas ni por descuido. La carpeta se crea sola al
# arrancar; lo que se versiona es su ausencia.
uploads/

# --- Temporales de compilación ----------------------------------------------
# GOTMPDIR local que usan run.sh y build.sh (~166 MB)
tmp/
tmp_tools/

# --- Sistema operativo / editores -------------------------------------------
.DS_Store
Thumbs.db
.idea/
*.swp

# Configuracion local de Claude Code
.claude/settings.local.json
